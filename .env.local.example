NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Required for automated schema push (npm run db:push)
# Get from: Supabase Dashboard → Project Settings → Database → Database password
SUPABASE_DB_PASSWORD=your-database-password

# Required for portal login sessions (generate a long random string)
AUTH_SECRET=your-long-random-secret-at-least-32-chars

# Optional: full connection string (overrides auto-built URL above)
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
