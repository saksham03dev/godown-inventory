# Stock-only mode: omit or set anything other than "true" to hide Billing.
# Set to true to restore full billing UI.
NEXT_PUBLIC_BILLING_ENABLED=false

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# REQUIRED — stock mutations + Auth Admin (create users / reset passwords).
# Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed for local `npm run db:push` (not required for Netlify runtime)
# SUPABASE_DB_PASSWORD=your-database-password
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
