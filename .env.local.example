NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# REQUIRED for stock in/out and billing unit attach (Netlify + local).
# Bypasses RLS and executes atomic Postgres RPCs.
# Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for portal login sessions (generate a long random string, 32+ chars)
AUTH_SECRET=your-long-random-secret-at-least-32-chars

# Only needed for local `npm run db:push` (not required for Netlify runtime)
# SUPABASE_DB_PASSWORD=your-database-password
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
